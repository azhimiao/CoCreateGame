{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:foundry:G01:game-spec:1.0.0",
  "$defs": {
    "level": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^L(0[1-9]|1[0-9]|20)$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "evidence_status": {
          "const": "HYPOTHESIS"
        },
        "mode": {
          "enum": [
            "BASE",
            "RELAY",
            "MANIFEST",
            "COMBINED"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 4,
          "maximum": 7
        },
        "height": {
          "type": "integer",
          "minimum": 4,
          "maximum": 7
        },
        "arrows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "direction": {
                "enum": [
                  "N",
                  "E",
                  "S",
                  "W"
                ]
              },
              "cells": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 1,
                "maxItems": 8
              },
              "toggles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "direction",
              "cells",
              "toggles"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 8
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "cells": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 1,
                "maxItems": 8
              },
              "initial_open": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "cells",
              "initial_open"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 2
        },
        "walls": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 0
        },
        "manifest": {
          "type": "array",
          "items": {
            "enum": [
              "N",
              "E",
              "S",
              "W"
            ]
          },
          "minItems": 0,
          "maxItems": 8
        },
        "initial_state": {
          "type": "object",
          "properties": {
            "removed": {
              "const": []
            },
            "manifest_cursor": {
              "const": 0
            }
          },
          "required": [
            "removed",
            "manifest_cursor"
          ],
          "additionalProperties": false
        },
        "win": {
          "type": "object",
          "properties": {
            "all_arrows_removed": {
              "const": true
            },
            "manifest_consumed": {
              "const": true
            }
          },
          "required": [
            "all_arrows_removed",
            "manifest_consumed"
          ],
          "additionalProperties": false
        },
        "solution": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "const": "EXIT"
              },
              "arrow_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            "required": [
              "type",
              "arrow_id"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 8
        },
        "learning_objective": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "target_seconds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "id",
        "name",
        "evidence_status",
        "mode",
        "width",
        "height",
        "arrows",
        "gates",
        "walls",
        "manifest",
        "initial_state",
        "win",
        "solution",
        "learning_objective",
        "seed",
        "target_seconds"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "spec_version": {
      "const": "1.0.0"
    },
    "game_id": {
      "const": "G01"
    },
    "working_title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "REVISION_REQUIRED"
    },
    "ready_for_build": {
      "const": false
    },
    "independent_review": {
      "const": "RECHECK_PENDING"
    },
    "human_build_approval": {
      "const": false
    },
    "preparation_date": {
      "const": "2026-10-21"
    },
    "all_design_values": {
      "const": "HYPOTHESIS"
    },
    "candidate_platform_ids": {
      "const": [
        "P02",
        "P04",
        "P05"
      ]
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "object",
      "properties": {
        "name": {
          "const": "Cocos Creator"
        },
        "candidate_version": {
          "const": "3.8.8"
        },
        "language": {
          "const": "TypeScript"
        },
        "version_source": {
          "type": "string",
          "minLength": 1
        },
        "checked_date": {
          "type": "string",
          "minLength": 1
        },
        "installation": {
          "type": "string",
          "minLength": 1
        },
        "build_tested": {
          "const": false
        }
      },
      "required": [
