    "rules": {
      "type": "object",
      "properties": {
        "coordinates": {
          "type": "string",
          "minLength": 1
        },
        "arrow_shape": {
          "type": "string",
          "minLength": 1
        },
        "movement": {
          "type": "string",
          "minLength": 1
        },
        "collision": {
          "type": "string",
          "minLength": 1
        },
        "exit_edge": {
          "type": "string",
          "minLength": 1
        },
        "legal_order": {
          "type": "array",
          "const": [
            "UNKNOWN_OR_REMOVED",
            "MANIFEST_MISMATCH",
            "ARROW_COLLISION",
            "WALL_COLLISION",
            "CLOSED_GATE"
          ]
        },
        "commit_order": {
          "type": "array",
          "const": [
            "validate complete sweep in pre-state",
            "remove arrow",
            "XOR each listed gate once",
            "advance manifest cursor if nonempty",
            "evaluate win then deadlock",
            "persist logical state",
            "animate"
          ]
        },
        "gate_semantics": {
          "type": "string",
          "minLength": 1
        },
        "manifest_semantics": {
          "type": "string",
          "minLength": 1
        },
        "invalid_action": {
          "type": "string",
          "minLength": 1
        },
        "deadlock": {
          "type": "string",
          "minLength": 1
        },
        "win": {
          "type": "string",
          "minLength": 1
        },
        "undo": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "rng": {
          "type": "string",
          "minLength": 1
        },
        "canonical_state_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "coordinates",
        "arrow_shape",
        "movement",
        "collision",
        "exit_edge",
        "legal_order",
        "commit_order",
        "gate_semantics",
        "manifest_semantics",
        "invalid_action",
        "deadlock",
        "win",
        "undo",
        "hint",
        "rng",
        "canonical_state_key"
      ],
      "additionalProperties": false
    },
    "session_contract": {
      "type": "object",
      "properties": {
        "rule_return": {
          "const": "Accepted(nextAttempt, ruleFacts) or Reject; never publishes events"
        },
        "rule_fact_fields": {
          "const": [
            "kind",
            "level_id",
            "arrow_id",
            "from_mask",
            "to_mask",
            "gate_changes",
            "manifest_cursor",
            "won",
            "deadlocked"
          ]
        },
        "forbidden_rule_fields": {
          "const": [
            "eventId",
            "sessionId",
            "firstClear",
            "stampCount",
            "completed"
          ]
        },
        "publisher": {
          "const": "SessionBus.publish, called only by SessionCoordinator"
        },
        "event_id": {
          "const": "boot-local sessionId + colon + strictly increasing positive sequence; allocated only by SessionCoordinator"
        },
        "completion_owner": {
          "const": "SessionCoordinator; firstClear computed from pre-action Progress.completed; stampCount from post-union completed set"
        },
        "save_owner": {
          "const": "SessionCoordinator emits one SaveRequested per accepted revision; SaveCoordinator only persists and returns result"
        },
        "save_ack": {
          "const": "SessionCoordinator publishes deduplicated SaveSucceeded/SaveFailed; acknowledgement never increments revision or triggers save"
        },
        "undo_policy": {
          "const": "Undo retains completed; completing again emits firstClear=false with unchanged stampCount; no REDO command exists"
        },
        "interrupt_policy": {
          "const": "Animation interruption never resubmits rule command or already queued snapshot; visibility flush deduplicates revision"
        },
        "rejection_policy": {
          "const": "Rejected action does not change revision/completed or request save"
        },
        "tasks": {
          "const": {
            "rule_facts": "T04",
            "session_state_machine_bus": "T06",
            "save_transport": "T07",
            "campaign_progress_integration": "T08"
          }
        }
      },
      "required": [
        "rule_return",
        "rule_fact_fields",
        "forbidden_rule_fields",
        "publisher",
        "event_id",
        "completion_owner",
        "save_owner",
        "save_ack",
        "undo_policy",
        "interrupt_policy",
        "rejection_policy",
        "tasks"
      ],
      "additionalProperties": false
    },
